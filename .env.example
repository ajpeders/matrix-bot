# Copy to .env and fill in to run this project standalone:
#   cp .env.example .env && docker compose up -d --build
# (In the homelab stack these come from services/matrix-musicbot/.env instead.)

# Matrix
MATRIX_DOMAIN=chat.yourdomain.com
MUSICBOT_USER=jukebox
MUSICBOT_PASSWORD=your_password_here

# LiveKit / Element Call
LIVEKIT_DOMAIN=livekit.yourdomain.com
LIVEKIT_KEY=your_livekit_key_here
LIVEKIT_SECRET=your_livekit_secret_here
LIVEKIT_SERVICE_URL=https://lk-jwt.yourdomain.com
VOICE_ROOM_ID=!roomid:chat.yourdomain.com

# Spotify URL support (optional) — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Web UI. Routers carry the local-only middleware (LAN + VPN) by default; to
# expose publicly, drop that middleware in docker-compose.yml and set a password.
MUSICBOT_DOMAIN=musicbot.yourdomain.com
MUSICBOT_WEB_PASSWORD=
MUSICBOT_WEB_API_KEY=
